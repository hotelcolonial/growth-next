# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — nunca se versionan los que llevan valores reales
.env
.env.local
.env*.local
.env.development
.env.production
.env*
# ...excepto la plantilla sin secretos, que SÍ debe estar en el repo.
# La negación va después de .env* a propósito: en git, la última regla que
# coincide es la que manda.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# copia de seguridad de las imágenes sin comprimir (solo local, nunca al repo)
/_originals/

# logs sueltos de corridas de dev
dev.log
